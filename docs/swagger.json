                }
            }
        },
        "github_com_abuamar142_auth-service_internal_models.LoginRequest": {
            "type": "object",
            "properties": {
                "identifier": {
                    "type": "string",
                    "example": "test@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "secretpass123"
                }
            }
        },
        "github_com_abuamar142_auth-service_internal_models.LogoutRequest": {
